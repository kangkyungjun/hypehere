# MarketLens Analytics - Environment Configuration Template
# Copy this file to .env and configure with your actual values
# NEVER commit .env to version control

# =============================================================================
# API Configuration
# =============================================================================

# Backend API Base URL
# Production server (default)
API_BASE_URL=http://43.201.45.60:8001

# Development overrides (uncomment when developing locally)
# API_BASE_URL=http://localhost:8001
# API_BASE_URL=http://127.0.0.1:8001

# =============================================================================
# Optional Configuration
# =============================================================================

# API timeout settings (in seconds)
# API_TIMEOUT=30

# Enable debug logging
# DEBUG_MODE=false

# =============================================================================
# Usage Instructions
# =============================================================================
# 1. Copy this file: cp .env.example .env
# 2. Edit .env with your actual configuration
# 3. Never commit .env to Git (it's already in .gitignore)
# 4. Keep .env.example updated when adding new environment variables
