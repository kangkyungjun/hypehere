/android/app/release
android/.gradle/
ios/Pods/

# ============================================
# SECRETS & CREDENTIALS (DO NOT COMMIT)
# ============================================

# Centralized secrets directory
secrets/

# Signing keys
*.jks
*.keystore
*.p8
*.p12
*.pem
/android/key.properties

# Environment variables
.env
.env.*
!.env.example

# Google Cloud / Firebase service account keys
gen-lang-client-*.json
*-service-account*.json
firebase-*.json
!firebase.json
# GCP service account key pattern: <project-id>-<12hex>.json
marketlens-*.json

# Firebase config files containing API keys
android/app/google-services.json
ios/Runner/GoogleService-Info.plist

# Fastlane credentials
fastlane/api_key.json

# Subscription / Auth keys
AuthKey_*.p8
SubscriptionKey_*.p8

# Databases
*.db
*.sqlite3
