# Django Environment
DJANGO_ENV=production

# Django Secret Key (Generate a new one: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())')
SECRET_KEY=your-secret-key-here-change-this

# Allowed Hosts (comma separated)
# Example with domain: ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
# Example with AWS IP: ALLOWED_HOSTS=43.200.129.55,localhost,127.0.0.1
ALLOWED_HOSTS=your-domain.com

# Database Configuration
DB_NAME=contactotalk
DB_USER=contactotalk
DB_PASSWORD=your-database-password-here
DB_HOST=localhost
DB_PORT=5432

# Redis Configuration
REDIS_URL=redis://127.0.0.1:6379/0

# CORS Origins (comma separated)
# Example with domain: CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
# Example with AWS IP: CORS_ALLOWED_ORIGINS=http://43.200.129.55:3000,http://43.200.129.55,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://127.0.0.1:8080
# Note: Include Flutter web ports (8080) if using Flutter web client
CORS_ALLOWED_ORIGINS=https://your-domain.com

# SSL Configuration (set to False if not using HTTPS initially)
SECURE_SSL_REDIRECT=True

# Frontend URLs (for reference - these are actually used in frontend .env.production)
# These should match your frontend configuration
# With domain:
#   NEXT_PUBLIC_API_URL=https://your-domain.com/api
#   NEXT_PUBLIC_WS_URL=wss://your-domain.com/ws
# With AWS IP (development/testing):
#   NEXT_PUBLIC_API_URL=http://43.200.129.55:8000/api
#   NEXT_PUBLIC_WS_URL=ws://43.200.129.55/ws
#
# IMPORTANT: WebSocket URL should use Nginx proxy path (/ws), NOT direct port (ws://ip:8001/ws)
NEXT_PUBLIC_API_URL=https://your-domain.com/api
