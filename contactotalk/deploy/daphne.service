[Unit]
Description=Daphne ASGI server for Contactotalk WebSocket
After=network.target postgresql.service redis.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/contactotalk
Environment="PATH=/home/ubuntu/contactotalk/venv/bin"
Environment="DJANGO_ENV=production"
EnvironmentFile=/home/ubuntu/contactotalk/.env.production
ExecStart=/home/ubuntu/contactotalk/venv/bin/daphne \
    -b 127.0.0.1 \
    -p 8001 \
    contactotalk.asgi:application
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
