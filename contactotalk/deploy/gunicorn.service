[Unit]
Description=Gunicorn daemon for Contactotalk Django API
After=network.target postgresql.service redis.service

[Service]
Type=notify
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/contactotalk
Environment="PATH=/home/ubuntu/contactotalk/venv/bin"
Environment="DJANGO_ENV=production"
EnvironmentFile=/home/ubuntu/contactotalk/.env.production
ExecStart=/home/ubuntu/contactotalk/venv/bin/gunicorn \
    --config /home/ubuntu/contactotalk/deploy/gunicorn.conf.py \
    contactotalk.wsgi:application
ExecReload=/bin/kill -s HUP $MAINPID
KillMode=mixed
TimeoutStopSec=5
PrivateTmp=true
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
