[Unit]
Description=Celery Worker for Contactotalk
After=network.target postgresql.service redis.service

[Service]
Type=forking
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/contactotalk
Environment="PATH=/home/ubuntu/contactotalk/venv/bin"
Environment="DJANGO_ENV=production"
EnvironmentFile=/home/ubuntu/contactotalk/.env.production
ExecStart=/home/ubuntu/contactotalk/venv/bin/celery -A contactotalk worker \
    --loglevel=info \
    --logfile=/home/ubuntu/contactotalk/logs/celery.log \
    --pidfile=/home/ubuntu/contactotalk/celery.pid
Restart=on-failure
RestartSec=10s

[Install]
WantedBy=multi-user.target
