#!/usr/bin/env bash
#
# Pre-commit hook: Detect secrets before they are committed.
# Blocks commits containing private keys, API keys, or known secret file patterns.
#

set -euo pipefail

RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m'

BLOCKED=0

# 1. Block known sensitive file paths
SENSITIVE_PATTERNS=(
    'gen-lang-client-.*\.json'
    'google-services\.json$'
    'GoogleService-Info\.plist$'
    'firebase-service-account.*\.json'
    'api_key\.json$'
    '\.env$'
    '\.env\.'
)

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null || true)

if [ -z "$STAGED_FILES" ]; then
    exit 0
fi

for pattern in "${SENSITIVE_PATTERNS[@]}"; do
    MATCHES=$(echo "$STAGED_FILES" | grep -E "$pattern" 2>/dev/null || true)
    if [ -n "$MATCHES" ]; then
        echo -e "${RED}[SECRET DETECTED]${NC} Sensitive file staged for commit:"
        echo "$MATCHES" | while read -r f; do echo "  - $f"; done
        BLOCKED=1
    fi
done

# 2. Scan staged content for secret patterns
SECRET_PATTERNS=(
    'PRIVATE KEY'
    'AIzaSy[A-Za-z0-9_-]{33}'
    'sk_live_[A-Za-z0-9]{20,}'
    'sk_test_[A-Za-z0-9]{20,}'
    'AKIA[0-9A-Z]{16}'
    'ghp_[A-Za-z0-9]{36}'
    'gho_[A-Za-z0-9]{36}'
    'glpat-[A-Za-z0-9_-]{20}'
)

for pattern in "${SECRET_PATTERNS[@]}"; do
    MATCHES=$(git diff --cached -U0 --diff-filter=ACM | grep -E "^\+" | grep -v "^\+\+\+" | grep -E "$pattern" 2>/dev/null || true)
    if [ -n "$MATCHES" ]; then
        echo -e "${RED}[SECRET DETECTED]${NC} Secret pattern found in staged changes: ${YELLOW}${pattern}${NC}"
        BLOCKED=1
    fi
done

if [ "$BLOCKED" -eq 1 ]; then
    echo ""
    echo -e "${RED}Commit blocked.${NC} Remove secrets before committing."
    echo "If this is a false positive, use: git commit --no-verify"
    exit 1
fi

exit 0
